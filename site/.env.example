# Copy to `.env` and fill in. Both values are compiled into the browser bundle
# by Vite, so treat them as public.
#
# Base URL of the HappyView instance serving the XRPC endpoints. Must be
# reachable by visitors' browsers — a localhost instance works for `npm run dev`
# but not for the deployed site.
VITE_HAPPYVIEW_URL=http://127.0.0.1:3000

# Public API client key. HappyView rejects XRPC requests without one, even
# anonymous reads. Create it under Settings > API Clients in the dashboard.
#
# Use only the `hvc_` client key here. The `hvs_` client secret it is issued
# alongside must never go in a browser bundle — it is the credential that
# proves control of the client.
VITE_HAPPYVIEW_CLIENT_KEY=hvc_
